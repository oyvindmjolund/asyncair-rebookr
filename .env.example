# Live API credentials - instructor only. Graduates never need keys.
# Copy to .env, fill in, then load in each terminal:  set -a; source .env; set +a
# Alternative: store the same names as Codespaces secrets on your GitHub account.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Azure OpenAI. Either the resource itself:   https://<resource>.openai.azure.com
# or an AI gateway (API Management) in front: https://<gateway>.azure-api.net/<api-path>
# Base address only - never the full Target URI and never /openai/v1.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Only when a gateway wants the key under another header than "api-key", e.g. x-api-key:
AZURE_OPENAI_KEY_HEADER=
